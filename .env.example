# Copy to .env for running the backend outside Docker:  cp .env.example .env
# Every setting is read from environment variables (see backend/app/core/config.py).

# --- Backend ---------------------------------------------------------------
# One plain PostgreSQL URL. The app derives the asyncpg (API) and psycopg2
# (Alembic) driver URLs from it. Neon example:
#   postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketsense

# Comma-separated browser origins allowed to call the API (your Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional overrides; the defaults point at backend/app/ml/artifacts/.
# MODEL_PATH=/absolute/path/to/ticket_classifier.joblib
# METRICS_PATH=/absolute/path/to/metrics.json

# Set by the hosting platform; defaults to 8000.
# PORT=8000

# --- Tests -----------------------------------------------------------------
# A throwaway database: tests drop and recreate its tables.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketsense_test

# --- Frontend (frontend/.env, build time) -----------------------------------
# Backend base URL. Leave empty: locally the Vite dev server proxies /api to :8000,
# and on Vercel frontend/vercel.json proxies /api to the Render backend.
# VITE_API_URL=https://your-backend.onrender.com
