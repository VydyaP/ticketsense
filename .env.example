# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ticketsense
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketsense

# Backend App Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Model Settings
MODEL_PATH=app/ml/artifacts/ticket_classifier.joblib
METRICS_PATH=app/ml/artifacts/metrics.json

# Logging & Monitoring
LOG_LEVEL=INFO
